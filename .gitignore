# Secrets. These must never enter the history — once committed they are public
# even after deletion, so this list is the last gate before `git add`.
.bus_token
.node_token
.node_tokens
.node_key
.node_key.*
user_email
host_id

# Local state. The store is a file on this machine; it holds real messages.
*.db
*.db-wal
*.db-shm
*.db.bak*
*.db-wal.bak*
*.db-shm.bak*

# Runtime output
*.out
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store

# Editor
.idea/
.vscode/

# Editable installs leave this behind. Contributors use the core install first,
# then `pip install -e '.[mcp]'` for the optional adapter test.
*.egg-info/

# Build output. `python -m build` writes both, and committing a wheel would leave
# a stale copy of the source in the repository.
build/
dist/
